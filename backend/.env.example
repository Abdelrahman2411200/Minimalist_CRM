# Copy to backend/.env. All credentials below are local development placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Match the root Compose .env. Percent-encode special characters in URL credentials.
DATABASE_URL=postgresql://crm:replace-with-local-password@127.0.0.1:5432/crm
# Disposable Compose test service. The verifier creates and drops its own database.
TEST_DATABASE_URL=postgresql://crm_test:synthetic-test-only@127.0.0.1:5433/crm_test
# Run npm run auth:setup --workspace backend to generate this locally without printing it.
SESSION_SECRET=
# Exact browser origin, with no trailing slash. Use https://<crm-domain> in production.
APP_ORIGIN=http://127.0.0.1:5173
# Set to 1 only when the app is reachable exclusively through one trusted reverse proxy.
TRUST_PROXY_HOPS=0
