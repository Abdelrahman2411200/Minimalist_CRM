# Local Compose settings. Use the same values in backend/.env's DATABASE_URL.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
# Container dashboard settings. auth:setup writes a random secret into the ignored .env.
SESSION_SECRET=
APP_PORT=8080
CRM_ORIGIN=http://127.0.0.1:8080
# Local Compose uses HTTP; production must use production + an HTTPS CRM_ORIGIN.
CRM_NODE_ENV=development
TRUST_PROXY_HOPS=0
