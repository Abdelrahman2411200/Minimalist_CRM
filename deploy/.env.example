# Copy to deploy/.env on the VPS, chmod 600, and replace every placeholder.
COMPOSE_PROJECT_NAME=minimalist-crm-production
CRM_HOST=crm.example.com
CRM_ORIGIN=https://crm.example.com
ACME_EMAIL=replace-with-your-email@example.com
CRM_IMAGE=ghcr.io/<owner>/<repo>:sha-<full-40-character-commit-sha>
CRM_MIGRATION_IMAGE=ghcr.io/<owner>/<repo>-migrate:sha-<same-commit-sha>
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CADDY_IMAGE=caddy:2.11.9-alpine
POSTGRES_IMAGE=postgres:18-alpine
PROXY_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
