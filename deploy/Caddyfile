{
	email {$ACME_EMAIL}
	admin off
}

{$CRM_HOST} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
	}
	# Caddy overwrites forwarded headers from untrusted clients. No access logging
	# here: URLs may contain contact searches; API/session material stays private.
	reverse_proxy app:3000
}
