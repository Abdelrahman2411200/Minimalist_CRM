{
  "uid": "crm-api",
  "title": "Minimalist CRM API",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "crm",
    "api"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "sum by (route) (rate(crm_api_http_requests_total{job=\"crm-api\"}[5m]))",
          "legendFormat": "{{route}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "API 5xx error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "100 * ((sum by (route) (rate(crm_api_http_requests_total{job=\"crm-api\",status_code=~\"5..\"}[5m])) or on (route) (0 * sum by (route) (rate(crm_api_http_requests_total{job=\"crm-api\"}[5m])))) / clamp_min(sum by (route) (rate(crm_api_http_requests_total{job=\"crm-api\"}[5m])), 1e-9))",
          "legendFormat": "{{route}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(crm_api_http_request_duration_seconds_bucket{job=\"crm-api\"}[5m])))",
          "legendFormat": "{{route}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    }
  ]
}
