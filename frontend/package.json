{
  "name": "@minimalist-crm/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc -b --pretty false && tsc -p tsconfig.tests.json",
    "build": "npm run build:full",
    "build:full": "tsc -b && vite build --mode full",
    "build:demo": "tsc -b && vite build --mode demo",
    "test": "tsx --test tests/data.test.ts",
    "test:e2e": "npm run db:generate --workspace @minimalist-crm/backend && tsx --test tests/browser.test.ts",
    "test:pages": "tsx --test tests/pages.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/express": "^5.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "tsx": "^4.20.6",
    "vite": "^8.3.8"
  }
}
