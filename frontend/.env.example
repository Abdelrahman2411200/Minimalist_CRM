# Copy to frontend/.env if you need to override the local defaults.
# Server-only Vite development setting; match backend HOST and PORT.
API_PROXY_TARGET=http://127.0.0.1:3000
# Public, build-time values: never place secrets in VITE_* variables.
VITE_APP_TITLE=Minimalist CRM
# Pages sets /<repo>/ automatically, or / for <owner>.github.io. Use / locally.
VITE_BASE_PATH=/
# Optional public link displayed in the standalone demo, e.g. https://<crm-domain>.
# The Pages build maps the Actions repository variable FULL_CRM_URL to this value.
VITE_FULL_CRM_URL=
